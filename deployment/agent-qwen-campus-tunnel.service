[Unit]
Description=Forward the campus canvas gateway to the Agent-Qwen web service
Wants=agent-qwen-canvas.service
After=network-online.target agent-qwen-canvas.service

[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o StrictHostKeyChecking=yes -o ForwardAgent=no -o ExitOnForwardFailure=yes -o ConnectTimeout=10 -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -R 127.0.0.1:27865:127.0.0.1:7865 cis-lab
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
