[Unit]
Description=Agent-Qwen connection to the cis-lab image generator
After=network-online.target

[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o StrictHostKeyChecking=yes -o ForwardAgent=no -o ExitOnForwardFailure=yes -o ConnectTimeout=10 -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -L 127.0.0.1:28188:127.0.0.1:18188 cis-lab
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
